# Copy to .env (dev) and .env.prod (release builds) — scripts/setup.sh does this
# for you. Both files are gitignored; only this template is committed.
#
# Values are baked in at build time via --dart-define-from-file, so a change here
# needs a rebuild, not a restart. See DEVELOPMENT.md → Configuration.

# Backend API base URL. No default — an unset value fails loudly at startup.
#   http://localhost:5000     web / iOS simulator
#   http://10.0.2.2:5000      Android emulator
#   http://<machine-ip>:5000  physical device on your LAN
API_BASE_URL=http://localhost:5000

# Google OAuth "Web application" client ID. See PRODUCTION.md → Google OAuth setup.
GOOGLE_CLIENT_ID=
