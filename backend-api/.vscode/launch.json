{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch API (Development)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/RideJournal.API/bin/Debug/net9.0/RideJournal.API.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/RideJournal.API",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5000"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Attach to API",
      "type": "coreclr",
      "request": "attach",
      "processName": "RideJournal.API"
    }
  ]
}
