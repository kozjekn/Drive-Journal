# Copy to .env (scripts/setup.sh does this for you).
# Read by docker-compose.prod.yml, which interpolates these into the container's
# Jwt__Secret and GoogleAuth__ClientId settings. Not used by `dotnet run` — local
# development reads appsettings.Development.json instead.

# Signing key for issued JWTs. Must be at least 32 characters.
JWT_SECRET=CHANGE_ME_at_least_32_characters_long!!

# Google OAuth "Web application" client ID; must match the app's GOOGLE_CLIENT_ID.
# See PRODUCTION.md → Google OAuth setup.
GOOGLE_CLIENT_ID=
